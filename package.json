{
  "name": "vocab-cards",
  "version": "1.0.0",
  "private": true,
  "description": "Tarjetas para estudiar vocabulario en inglés: pronunciación, contextos y ejemplos, con tarjetas generadas por IA.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch-path=server server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "preview": "npm run build && npm start",
    "test": "node --test --disable-warning=ExperimentalWarning \"server/test/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "vite": "^8.3.1"
  }
}
