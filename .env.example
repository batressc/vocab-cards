# Copia este archivo como .env y completa los valores. .env NO se sube a Git.
# npm run dev y npm start lo cargan automáticamente.

# Clave para agregar, editar o eliminar tarjetas desde el sitio (mínimo 12 caracteres).
# Si queda vacía, se genera una temporal en cada arranque y se muestra en la consola.
ADMIN_TOKEN=

# En desarrollo, define la clave específica de cada proveedor que quieras mostrar.
OPENCODE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Azure OpenAI se activa solo cuando ambas variables tienen valor.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Compatibilidad: solo se usa si config.json declara un único proveedor con clave pendiente.
AI_API_KEY=

# En producción, usa un archivo JSON allowlisted para rotar claves sin recrear el contenedor.
# Cuando se define, el archivo es autoritativo y las claves anteriores se ignoran.
# AI_CREDENTIALS_FILE=/run/secrets/vocab-ai/credentials.json

# Opcionales: escalares tipados que sobrescriben config.json.
# PORT=3000
# VOCAB_DB=data/vocab.db
# VOCAB_DATA_FOLDER=data/seed
# VOCAB_INCLUDE_SUBFOLDERS=false
# VOCAB_SEED_FROM_FOLDER_WHEN_EMPTY=true
# VOCAB_PAGE_SIZE=12
# VOCAB_MAX_PAGE_SIZE=100
# VOCAB_MAX_IMPORT_BYTES=5242880
# VOCAB_MAX_BACKUP_BYTES=67108864
# VOCAB_TRUST_PROXY=false
# AI_TIMEOUT_MS=90000
# AI_CATALOG_TTL_MS=300000
# AI_CATALOG_TIMEOUT_MS=10000
# AI_MAX_TERMS=10
# HOST=0.0.0.0
# VOCAB_CONFIG=config.json

# Solo Docker Compose: ruta absoluta al directorio que contiene credentials.json.
# AI_SECRETS_DIR=/srv/vocab-cards/secrets
# VOCAB_BIND_ADDRESS=127.0.0.1
# VOCAB_PORT=3000
