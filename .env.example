# Copia este archivo como .env y completa los valores. .env NO se sube a Git.
# npm run dev y npm start lo cargan automáticamente.

# Clave para agregar, editar o eliminar tarjetas desde el sitio (mínimo 12 caracteres).
# Si queda vacía, se genera una temporal en cada arranque y se muestra en la consola.
ADMIN_TOKEN=

# Clave del proveedor de IA configurado en config.json (ai.provider). Solo hace falta la que uses.
OPENCODE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
# Sirve para cualquier proveedor y tiene prioridad sobre las anteriores.
AI_API_KEY=

# Opcionales: sobrescriben config.json.
# PORT=3000
# VOCAB_DB=data/vocab.db
